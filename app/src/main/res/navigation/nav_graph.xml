<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/feedFragment">

    <!--
        Feed 主页 — 包含顶部 Tab 导航 + ViewPager2 + 信息流列表。
        搜索按钮和详情页跳转都会从这里发起。
    -->
    <fragment
        android:id="@+id/feedFragment"
        android:name="com.aiads.ui.feed.FeedFragment"
        android:label="Feed" >
        <action
            android:id="@+id/action_to_detail"
            app:destination="@id/detailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_to_dashboard"
            app:destination="@id/analyticsDashboardFragment" />
        <action
            android:id="@+id/action_to_search"
            app:destination="@id/searchFragment" />

    </fragment>

    <!--
        SearchFragment — 搜索页（M13 实现）。
        暂为占位，确保导航图和 FeedFragment 可以直接引用对应的 action。
    -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.aiads.ui.search.SearchFragment"
        android:label="搜索" />

    <!--
        DetailFragment — 详情页（M8 实现）。
        接收 adId 参数，通过 Navigation Argument 从 Feed 或搜索页传入。
    -->
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.aiads.ui.detail.DetailFragment"
        android:label="详情">
        <argument
            android:name="adId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/analyticsDashboardFragment"
        android:name="com.aiads.ui.analytics.AnalyticsDashboardFragment"
        android:label="数据看板" />


</navigation>
