# Docker Compose 环境中 host 用服务名（postgres / redis）
# 本地开发（不在 Docker 中运行时）改为 localhost
DATABASE_URL=postgresql+asyncpg://aiads:aiads@postgres:5432/aiads
REDIS_URL=redis://redis:6379/0
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
CELERY_BROKER_URL=redis://redis:6379/1
FEED_CACHE_TTL=300
LLM_REQUEST_TIMEOUT=30
