<?xml version="1.0" encoding="utf-8"?>
<!--
     卡片公共信息区 + 操作区，被 4 种卡片布局通过 <include> 引用。

     所有控件的 ID 与之前保持一致，BaseCardViewHolder 通过 findViewById
     在 itemView 上查找这些 ID——无论它们位于 include 内还是外层，都能找到。
 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 使用 <merge> 而非 LinearLayout：避免嵌套一层多余的 ViewGroup，
         直接合并到引用者的父布局中 -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvAiSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#999999"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleLine="true"
        app:chipSpacingHorizontal="6dp" />

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnLike"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@drawable/selector_like"
            android:contentDescription="点赞" />

        <ImageButton
            android:id="@+id/btnBookmark"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@drawable/selector_bookmark"
            android:contentDescription="收藏" />

        <ImageButton
            android:id="@+id/btnShare"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@drawable/selector_share"
            android:contentDescription="转发" />
    </LinearLayout>

</merge>